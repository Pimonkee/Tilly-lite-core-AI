# Tilly AI - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# Primary LLM Provider (gemini, deepseek, or ollama)
TILLY_PRIMARY_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
TILLY_PRIMARY_MODEL=gemini-pro

# DeepSeek Configuration (if using DeepSeek as primary or fallback)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Ollama Configuration (if using local Ollama)
# OLLAMA_HOST=http://localhost:11434

# Fallback Provider (optional)
# TILLY_FALLBACK_PROVIDER=ollama
# FALLBACK_API_KEY=your_fallback_api_key_here
# TILLY_FALLBACK_MODEL=llama2

# =============================================================================
# Application Settings
# =============================================================================

# Environment (development, staging, production)
TILLY_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
TILLY_LOG_LEVEL=INFO

# Data Directory Path
TILLY_DATA_ROOT=./data

# =============================================================================
# Model Parameters
# =============================================================================

# Temperature (0.0 - 1.0, higher = more creative)
TILLY_TEMPERATURE=0.7

# Maximum Tokens per Response
TILLY_MAX_TOKENS=1024

# =============================================================================
# Server Configuration
# =============================================================================

# Server Host
HOST=0.0.0.0

# Server Port
PORT=8000

# Enable Auto-reload (development only)
RELOAD=false

# =============================================================================
# Security (Production)
# =============================================================================

# Secret Key for Sessions (generate with: openssl rand -hex 32)
# SECRET_KEY=your_secret_key_here

# CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# =============================================================================
# Optional Features
# =============================================================================

# OCR Configuration (if using Tesseract)
# TESSERACT_PATH=/usr/bin/tesseract

# Database Configuration (if using database features)
# DATABASE_URL=sqlite:///./data/tilly.db

# Redis Configuration (if using Redis for caching)
# REDIS_URL=redis://localhost:6379
